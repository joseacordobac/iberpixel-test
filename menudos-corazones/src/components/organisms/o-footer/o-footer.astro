---
import './o-footer.css';
import AImage from '../../atoms/a-image/a-image.astro';

interface Props {
  class?: string;
  [key: string]: any;
}

const { class: className = '', ...rest } = Astro.props;
---

<footer class={`o-footer ${className}`} {...rest}>
  <div class="o-footer__container">
    {/* Left Column: Brand & Contacts */}
    <div class="o-footer__left">
      <a href="#hero-banner" class="o-footer__logo-link">
        <AImage src="/mc-logo.svg" alt="Fundación Menudos Corazones" class="o-footer__logo" />
      </a>
      
      <div class="o-footer__addresses">
        <p class="o-footer__address">
          C/ Doctor Castelo, 49 - 1º<br />
          28009 Madrid · España
        </p>
        <p class="o-footer__address">
          Paseo de Juan Antonio Vallejo-Nájera Botas S/N, esquina C/ Ercilla, 43<br />
          28005 Madrid · España
        </p>
      </div>

      <div class="o-footer__contact">
        <a href="tel:+34913736746" class="o-footer__contact-item">
          <svg class="o-footer__contact-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z" />
          </svg>
          <span class="o-footer__contact-text">91 3736746 / 91 3866122</span>
        </a>

        <a href="mailto:correoprueba@menudoscorazones.org" class="o-footer__contact-item">
          <svg class="o-footer__contact-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" />
            <polyline points="22,6 12,13 2,6" />
          </svg>
          <span class="o-footer__contact-text">correoprueba@menudoscorazones.org</span>
        </a>
      </div>
    </div>

    {/* Right Column: Newsletter, Nav & Socials */}
    <div class="o-footer__right">
      <div class="o-footer__newsletter">
        <h3 class="o-footer__newsletter-title">Suscríbete a nuestra newsletter</h3>
        
        <form class="o-footer__form" id="newsletter-form">
          <div class="o-footer__form-row">
            <input 
              type="email" 
              name="email" 
              placeholder="Escribe tu Email" 
              required 
              class="o-footer__input" 
              aria-label="Email para newsletter"
            />
            <button type="submit" class="o-footer__submit-btn">
              Suscribirme
            </button>
          </div>
          
          <label class="o-footer__privacy-label">
            <div class="o-footer__checkbox-wrapper">
              <input type="checkbox" required class="o-footer__checkbox" />
              <div class="o-footer__custom-checkbox">
                <svg class="o-footer__checkmark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="20 6 9 17 4 12" />
                </svg>
              </div>
            </div>
            <span class="o-footer__privacy-text">
              He leído y acepto la política de privacidad de la Fundación Menudos Corazones *
            </span>
          </label>
        </form>
      </div>

      <nav class="o-footer__nav" aria-label="Navegación de pie de página">
        <ul class="o-footer__nav-list">
          <li><a href="#hero-banner" class="o-footer__nav-link">Campaña</a></li>
          <li><a href="#realidad" class="o-footer__nav-link">Realidad</a></li>
          <li><a href="#voces" class="o-footer__nav-link">Voces</a></li>
          <li><a href="#relatos" class="o-footer__nav-link">Participa</a></li>
          <li><a href="#realidad" class="o-footer__nav-link">Impacto</a></li>
          <li><a href="#donation-form" class="o-footer__nav-link">Colabora</a></li>
          <li><a href="#realidad" class="o-footer__nav-link">Gracias</a></li>
        </ul>
      </nav>

      <div class="o-footer__social">
        <span class="o-footer__social-label">Siguenos en:</span>
        <div class="o-footer__social-icons">
          <a href="https://facebook.com" target="_blank" rel="noopener noreferrer" class="o-footer__social-link" aria-label="Facebook">
            <svg class="o-footer__social-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z" />
            </svg>
          </a>
          <a href="https://instagram.com" target="_blank" rel="noopener noreferrer" class="o-footer__social-link" aria-label="Instagram">
            <svg class="o-footer__social-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5" />
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z" />
              <line x1="17.5" y1="6.5" x2="17.51" y2="6.5" />
            </svg>
          </a>
          <a href="https://linkedin.com" target="_blank" rel="noopener noreferrer" class="o-footer__social-link" aria-label="LinkedIn">
            <svg class="o-footer__social-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z" />
              <rect x="2" y="9" width="4" height="12" />
              <circle cx="4" cy="4" r="2" />
            </svg>
          </a>
          <a href="https://youtube.com" target="_blank" rel="noopener noreferrer" class="o-footer__social-link" aria-label="YouTube">
            <svg class="o-footer__social-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22.54 6.42a2.78 2.78 0 0 0-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 0 0-1.94 2A29 29 0 0 0 1 11.75a29 29 0 0 0 .46 5.33A2.78 2.78 0 0 0 3.4 19c1.72.46 8.6.46 8.6.46s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.94-2 29 29 0 0 0 .46-5.25 29 29 0 0 0-.46-5.33z" />
              <polygon points="9.75 15.02 15.5 11.75 9.75 8.48 9.75 15.02" />
            </svg>
          </a>
          <a href="https://twitter.com" target="_blank" rel="noopener noreferrer" class="o-footer__social-link" aria-label="Twitter">
            <svg class="o-footer__social-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M23 3a10.9 10.9 0 0 1-3.14 1.53 4.48 4.48 0 0 0-7.86 3v1A10.66 10.66 0 0 1 3 4s-4 9 5 13a11.64 11.64 0 0 1-7 2c9 5 20 0 20-11.5a4.5 4.5 0 0 0-.08-.83A7.72 7.72 0 0 0 23 3z" />
            </svg>
          </a>
          <a href="https://whatsapp.com" target="_blank" rel="noopener noreferrer" class="o-footer__social-link" aria-label="WhatsApp">
            <!-- Render custom WhatsApp icon -->
            <svg class="o-footer__social-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </div>

  <div class="o-footer__bottom">
    <div class="o-footer__bottom-container">
      <p class="o-footer__copy">© Todos los derechos reservados</p>
    </div>
  </div>
</footer>

<script>
  // Quick newsletter interactive feedback
  const form = document.getElementById('newsletter-form');
  if (form) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const emailInput = form.querySelector('input[type="email"]') as HTMLInputElement;
      if (emailInput && emailInput.value) {
        alert(`¡Gracias por suscribirte con: ${emailInput.value}!`);
        emailInput.value = '';
        const checkbox = form.querySelector('input[type="checkbox"]') as HTMLInputElement;
        if (checkbox) checkbox.checked = false;
      }
    });
  }
</script>
