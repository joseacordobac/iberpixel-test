---
import './a-image.css';

interface Props {
  src: string;
  alt: string;
  variant?: 'rounded' | 'circle' | 'default';
  class?: string;
  id?: string;
  loading?: 'lazy' | 'eager';
  [key: string]: any;
}

const {
  src,
  alt,
  variant = 'default',
  class: className = '',
  id,
  loading = 'lazy',
  ...rest
} = Astro.props;

const classes = `a-image ${variant !== 'default' ? `a-image--${variant}` : ''} ${className}`.trim();
---

<img
  src={src}
  alt={alt}
  class={classes}
  id={id}
  loading={loading}
  {...rest}
/>
