---
// Component to initialize GSAP animations globally on the client side
---
<script>
  import { initGSAP, scrollProgressBar } from '../../../scripts/gsap-init';

  function initGlobalAnimations() {
    initGSAP();
    scrollProgressBar('.scroll-progress-bar');
  }

  // Initialize immediately
  initGlobalAnimations();

  // Re-initialize after Astro Page transitions if they are used
  document.addEventListener('astro:page-load', () => {
    initGlobalAnimations();
  });
</script>
