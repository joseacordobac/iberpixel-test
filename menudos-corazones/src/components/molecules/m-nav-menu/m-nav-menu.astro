---
import './m-nav-menu.css';
import AButton from '../../atoms/a-button/a-button.astro';

interface Props {
  class?: string;
  [key: string]: any;
}

const { class: className = '', ...rest } = Astro.props;

const menuItems = [
  { label: 'Campaña', href: '#hero-banner' },
  { label: 'Realidad', href: '#realidad' },
  { label: 'Voces', href: '#voces' },
  { label: 'Relatos', href: '#relatos' },
  { label: 'Impacto', href: '#realidad' },
  { label: 'Colabora', href: '#voces' },
  { label: 'Gracias', href: '#relatos' }
];
---

<ul class={`m-nav-menu ${className}`} {...rest}>
  {
    menuItems.map((item) => (
      <li class="m-nav-menu__item">
        <AButton variant="nav" href={item.href}>
          {item.label}
        </AButton>
      </li>
    ))
  }
</ul>
